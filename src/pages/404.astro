---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for could not be found.">
  <section class="section center">
    <div class="container narrow-center">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page.</h1>
      <p class="lead mx-auto" style="text-align:center">
        The page you were looking for may have moved or no longer exists.
        Let's get you back on track.
      </p>
      <div class="mt-2 nf-actions">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/services" class="btn btn-ghost" style="border-color:var(--line)">Services</a>
        <a href="/contact" class="btn btn-ghost" style="border-color:var(--line)">Contact</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow-center { max-width: 60ch; }
  .section.center { padding-block: clamp(4rem, 10vw, 7rem); }
  .nf-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
</style>
