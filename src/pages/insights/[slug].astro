---
import Layout from '../../layouts/Layout.astro';
import { posts, getPost, sortedPosts } from '../../data/insights.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const more = sortedPosts().filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Layout title={`${post.title} — Insights`} description={post.excerpt}>
  <article>
    <!-- ---- Article header ---- -->
    <header class="post-header">
      <div class="container narrow">
        <a href="/insights" class="back-link">← All insights</a>
        <span class="post-cat">{post.category}</span>
        <h1>{post.title}</h1>
        <p class="post-meta">{post.author} · {post.dateLabel}</p>
      </div>
    </header>

    <!-- ---- Body ---- -->
    <div class="section">
      <div class="container narrow post-body">
        {post.body.map((block) => (
          <>
            {block.h2 && <h2>{block.h2}</h2>}
            {block.p && <p>{block.p}</p>}
            {block.ul && (
              <ul class="post-list">
                {block.ul.map((li) => <li>{li}</li>)}
              </ul>
            )}
          </>
        ))}

        <div class="post-cta">
          <p>Have a project — or a cost question — you'd like to talk through?</p>
          <a href="/contact" class="btn btn-primary">Talk to a cost manager</a>
        </div>
      </div>
    </div>
  </article>

  <!-- ---- More ---- -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head"><h2 class="section-title underline-accent">Keep reading</h2></div>
      <div class="grid grid-2">
        {more.map((p) => (
          <a href={`/insights/${p.slug}`} class="card card-accent card-hover post-card">
            <span class="post-cat">{p.category}</span>
            <h3 style="margin-top:0.6rem">{p.title}</h3>
            <p class="post-excerpt">{p.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 46rem; }
  .post-header {
    color: #fff;
    background: linear-gradient(120deg, var(--blue-900), var(--blue));
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
  }
  .back-link { display: block; color: #cde0ff; font-weight: 600; font-size: 0.85rem; margin-bottom: 1.1rem; }
  .back-link:hover { color: #fff; }
  .post-header .post-cat { color: #bfe29a; }
  .post-header h1 {
    color: #fff; text-transform: none; font-size: clamp(1.9rem, 4.6vw, 3rem);
    letter-spacing: -0.01em; margin: 0.5rem 0 0.6rem; line-height: 1.1;
  }
  .post-header .post-meta { color: #dbe6f7; }

  .post-cat { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-ink); }
  .post-meta { font-size: 0.85rem; margin: 0; }

  .post-body :global(h2) {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem); font-weight: 700; margin: 2rem 0 0.75rem;
    text-transform: none; letter-spacing: -0.005em;
  }
  .post-body :global(p) { font-size: 1.08rem; color: var(--body); margin: 0 0 1.15rem; }
  .post-list { margin: 0 0 1.25rem; padding-left: 1.3rem; display: grid; gap: 0.5rem; }
  .post-list li { color: var(--body); font-size: 1.05rem; }
  .post-list li::marker { color: var(--green); }

  .post-cta {
    margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line);
  }
  .post-cta p { font-weight: 600; color: var(--ink); }

  .post-card { display: block; color: inherit; }
  .post-card:hover { color: inherit; }
  .post-excerpt { color: var(--body); font-size: 0.96rem; margin-top: 0.5rem; }
</style>
