---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const sectors = [
  {
    name: 'Government',
    body: 'Independent cost and construction management for civic buildings, public works, and agency facilities — keeping public dollars accountable and defensible.',
  },
  {
    name: 'Healthcare',
    body: 'Cost intelligence for complex, highly regulated medical environments, where budget certainty and phased delivery matter most.',
  },
  {
    name: 'Higher Education',
    body: 'Estimating and owner-side management for campus buildings and infrastructure, aligning cost with institutional priorities.',
  },
  {
    name: 'K-12',
    body: 'Cost planning and stewardship for schools and district facilities, helping owners deliver on bond and levy commitments.',
  },
  {
    name: 'Parks',
    body: 'Cost management for parks, recreation, and public open-space projects, from concept planning through construction.',
  },
  {
    name: 'Ports',
    body: 'Estimating and construction management for marine and port facilities, supporting delivery in demanding operational settings.',
  },
  {
    name: 'Transportation & Utilities',
    body: 'Owner-focused cost and construction management for transit, roadway, and utility infrastructure across the region.',
  },
  {
    name: 'Zoos & Animal Welfare',
    body: 'Specialized cost management for zoo, aquarium, and animal-care facilities, balancing budget with the unique needs of these environments.',
  },
];
---

<Layout title="Projects" description="DCW delivers independent cost and construction management across government, healthcare, education, parks, ports, transportation, and more — including Colman Dock for Washington State Ferries.">
  <PageHeader
    eyebrow="Projects"
    title="Owner-centered work across the sectors that matter."
    lead="From landmark marine terminals to schools, parks, and public infrastructure, DCW helps owners deliver with confidence — more than 400 projects every year."
  />

  <!-- Colman Dock case study -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Case study</span>
        <h2>Colman Dock — Seattle Ferry Terminal</h2>
      </div>
      <div class="case">
        <div class="case-main">
          <span class="tag">Transportation &amp; Utilities · Marine</span>
          <dl class="case-meta">
            <div>
              <dt>Client</dt>
              <dd>Washington State Ferries (WSDOT)</dd>
            </div>
            <div>
              <dt>DCW's role</dt>
              <dd>
                Independent cost management and estimating for the replacement of
                one of the busiest ferry terminals on the West Coast. DCW
                supported the owner through phased construction while the
                terminal stayed in full operation — helping keep budget, scope,
                and schedule aligned on a complex, high-visibility project.
              </dd>
            </div>
          </dl>
        </div>
        <aside class="case-aside">
          <span class="num">400+</span>
          <span class="num-label">projects delivered each year</span>
          <p>
            Colman Dock reflects the kind of demanding public work DCW takes on
            every day — independent, owner-side cost and construction management
            that owners can trust and defend.
          </p>
          <a href="/contact" class="btn btn-primary">Start a conversation</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section class="section section-sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Markets we serve</span>
        <h2>Deep experience across public and institutional sectors.</h2>
        <p class="lead">
          DCW brings the same independent, owner-first discipline to every
          market we work in — giving owners cost clarity from first business
          case through closeout.
        </p>
      </div>
      <div class="grid grid-3">
        {sectors.map((s) => (
          <div class="card card-accent">
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-navy">
    <div class="container center">
      <h2>Have a project in one of these sectors?</h2>
      <p class="lead mx-auto" style="text-align:center;color:#c7d2dd">
        We'd welcome the chance to talk through how DCW can support your next
        civic, transit, or public project.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .case {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .case-meta {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1.1rem;
  }
  .case-meta dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--slate-light);
    margin-bottom: 0.2rem;
  }
  .case-meta dd { margin: 0; color: var(--slate); }
  .case-aside {
    background: var(--sand);
    border-top: 4px solid var(--copper);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .case-aside .num {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--copper);
    line-height: 1;
    display: block;
  }
  .case-aside .num-label {
    display: block;
    font-size: 0.9rem;
    color: var(--slate-light);
    margin: 0.35rem 0 1rem;
  }
  @media (max-width: 760px) {
    .case { grid-template-columns: 1fr; }
  }
</style>
