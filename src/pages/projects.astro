---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const featured = {
  name: 'Colman Dock',
  sector: 'Transportation / Marine',
  body:
    'Colman Dock is the primary ferry terminal for Washington State. DCW developed a comparative cost estimate to reconcile with the contractor across the Entry Building and Elevated Pedestrian Connector, and reviewed change orders spanning dry systems, electrical, mechanical, and structural work, in-water infrastructure, a temporary pedestrian bridge, and roadway modifications — all while the terminal stayed in full operation.',
};

const projects = [
  { name: 'University Link Light Rail Station', sector: 'Transit / Infrastructure', client: 'Sound Transit', role: 'Cost estimating and management for a deep-bore underground light-rail station, helping the owner control budget on a highly complex transit project.' },
  { name: 'Mount Vernon Library Commons', sector: 'Civic / Library', client: 'City of Mount Vernon', role: 'Cost management alongside HKP Architects for a mixed-use civic library and commons, aligning budget with design intent from concept through construction.' },
  { name: 'Bellingham Ops Admin Center & Vehicle Barn', sector: 'Municipal / Public Works', client: 'City of Bellingham', role: "Cost and construction management for a combined operations center and vehicle maintenance barn, with owner's-side oversight through delivery." },
  { name: 'Charles D. Cameron Public Services Building', sector: 'Government / Civic', client: 'Washington County, Oregon', role: "Cost management and owner's representation for a consolidated public services building, keeping cost and scope aligned with program goals." },
  { name: 'Hemisfair', sector: 'Urban Redevelopment', client: 'Hemisfair Park Area Redevelopment Corp.', role: 'Independent cost planning and management supporting the phased redevelopment of a signature urban park and mixed-use district.' },
];

const markets = [
  'Government', 'Healthcare', 'Higher Education', 'K-12',
  'Parks', 'Ports', 'Transportation & Utilities', 'Zoos & Animal Welfare',
];
---

<Layout
  title="Projects"
  description="Landmark cost and construction management projects by DCW — transit, civic, marine, and government work across the Pacific Northwest and beyond."
>
  <PageHeader
    eyebrow="Projects"
    title="Landmark work across sectors"
    lead="We aim to be your trusted advisor from start to finish. DCW works on 400+ projects a year — here is a sampling of our collaborations."
  />

  <!-- ---- Featured project ---- -->
  <section class="section">
    <div class="container featured">
      <div class="featured-media" aria-hidden="true">
        <!-- Drop /public/colman-dock.jpg and set as background to use a photo. -->
        <span class="tag">{featured.sector}</span>
      </div>
      <div class="featured-body">
        <span class="eyebrow">Featured project</span>
        <h2 class="section-title"><strong>{featured.name}</strong></h2>
        <p>{featured.body}</p>
        <a href="/contact" class="btn btn-primary mt-1">Discuss a project like this</a>
      </div>
    </div>
  </section>

  <!-- ---- Project list ---- -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Selected work</span>
        <h2 class="section-title underline-accent">Where owners trust us to&nbsp;deliver</h2>
      </div>
      <div class="project-list">
        {projects.map((p, i) => (
          <article class="project card card-hover">
            <div class="project-index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</div>
            <div class="project-main">
              <span class="tag">{p.sector}</span>
              <h3>{p.name}</h3>
              <dl class="project-meta">
                <div><dt>Client</dt><dd>{p.client}</dd></div>
                <div><dt>DCW's role</dt><dd>{p.role}</dd></div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- Projects by market ---- -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2 class="section-title center">Projects by market</h2>
        <p class="lead mx-auto" style="text-align:center">
          Every project is unique, and we enjoy engaging in that process with you.
          Explore the sectors where DCW brings market-based expertise.
        </p>
      </div>
      <div class="grid grid-4 market-grid">
        {markets.map((m, i) => (
          <div class="market-tile" style={`--i:${i}`}>
            <span class="market-label">{m}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- CTA ---- -->
  <section class="section section-blue center">
    <div class="container">
      <h2 class="section-title center">Have a project like these?</h2>
      <p class="lead mx-auto" style="text-align:center;color:#dbe6f7">
        We'd welcome the chance to talk through how DCW can support your next
        civic, transit, or public project.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary btn-lg">Collaborate Today!</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  @media (max-width: 820px) { .featured { grid-template-columns: 1fr; } }
  .featured-media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    background: linear-gradient(140deg, var(--blue) 0%, var(--blue-900) 60%, var(--teal) 130%);
    box-shadow: var(--shadow-md);
  }
  .featured-media .tag { position: absolute; top: 1rem; left: 1rem; background: #fff; color: var(--blue); }
  .featured-body h2 { margin-bottom: 0.75rem; }

  .project-list { display: grid; gap: 1.25rem; }
  .project {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: start;
  }
  .project-index { font-weight: 800; font-size: 2rem; color: var(--green); line-height: 1; }
  .project-main h3 { margin: 0.5rem 0 0.85rem; font-size: 1.3rem; color: var(--ink); }
  .project-meta { margin: 0; display: grid; gap: 0.8rem; }
  .project-meta dt {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em;
    font-weight: 700; color: var(--blue); margin-bottom: 0.15rem;
  }
  .project-meta dd { margin: 0; color: var(--body); }
  @media (max-width: 560px) { .project { grid-template-columns: 1fr; } .project-index { font-size: 1.6rem; } }

  /* Market tiles (shared look with home) */
  .market-tile {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: #fff;
    background: linear-gradient(180deg, rgba(15,44,88,0.15), rgba(15,44,88,0.78)), linear-gradient(140deg, var(--blue), var(--blue-900) 60%, var(--teal) 130%);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .market-tile:nth-child(even) {
    background: linear-gradient(180deg, rgba(15,44,88,0.15), rgba(15,44,88,0.80)), linear-gradient(140deg, var(--teal) -20%, var(--blue) 55%, var(--blue-900) 120%);
  }
  .market-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .market-label {
    position: absolute; left: 1rem; bottom: 0.9rem; right: 1rem;
    font-weight: 700; font-size: 1.02rem; text-shadow: 0 1px 8px rgba(0,0,0,0.35);
  }
</style>
