---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const featured = {
  name: 'Colman Dock',
  sector: 'Transportation & Utilities · Marine',
  client: 'Washington State Ferries (WSDOT)',
  body:
    'Independent cost management and estimating for the replacement of one of the busiest ferry terminals on the West Coast. DCW developed a comparative cost estimate to reconcile with the contractor across the Entry Building and Elevated Pedestrian Connector, and reviewed change orders spanning dry systems, electrical, mechanical, and structural work, in-water infrastructure, a temporary pedestrian bridge, and roadway modifications — all while the terminal stayed in full operation.',
};

const markets = [
  { name: 'Government', body: 'Independent cost and construction management for civic buildings, public works, and agency facilities — keeping public dollars accountable and defensible.' },
  { name: 'Healthcare', body: 'Cost intelligence for complex, highly regulated medical environments, where budget certainty and phased delivery matter most.' },
  { name: 'Higher Education', body: 'Estimating and owner-side management for campus buildings and infrastructure, aligning cost with institutional priorities.' },
  { name: 'K-12', body: 'Cost planning and stewardship for schools and district facilities, helping owners deliver on bond and levy commitments.' },
  { name: 'Parks', body: 'Cost management for parks, recreation, and public open-space projects, from concept planning through construction.' },
  { name: 'Ports', body: 'Estimating and construction management for marine and port facilities, supporting delivery in demanding operational settings.' },
  { name: 'Transportation & Utilities', body: 'Owner-focused cost and construction management for transit, roadway, and utility infrastructure across the region.' },
  { name: 'Zoos & Animal Welfare', body: 'Specialized cost management for zoo, aquarium, and animal-care facilities, balancing budget with the unique needs of these environments.' },
];
---

<Layout
  title="Projects"
  description="DCW delivers independent cost and construction management across government, healthcare, education, parks, ports, transportation, and more — including Colman Dock for Washington State Ferries."
>
  <PageHeader
    eyebrow="Projects"
    title="Owner-centered work across the sectors that matter"
    lead="From landmark marine terminals to schools, parks, and public infrastructure, DCW helps owners deliver with confidence — more than 400 projects every year."
  />

  <!-- ---- Colman Dock case study (verified) ---- -->
  <section class="section">
    <div class="container featured">
      <div class="featured-media">
        <img src="/qtq80-gQrixd-2048x1404.jpeg" alt="" loading="lazy" decoding="async" />
        <span class="tag">{featured.sector}</span>
      </div>
      <div class="featured-body">
        <span class="eyebrow">Case study</span>
        <h2 class="section-title"><strong>{featured.name}</strong><br />Seattle Ferry Terminal</h2>
        <p class="client-line"><strong>Client:</strong> {featured.client}</p>
        <p>{featured.body}</p>
        <a href="/contact" class="btn btn-primary mt-1">Discuss a project like this</a>
      </div>
    </div>
  </section>

  <!-- ---- Markets we serve ---- -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Markets we serve</span>
        <h2 class="section-title underline-accent">Deep experience across public &amp; institutional&nbsp;sectors</h2>
        <p class="lead">
          DCW brings the same independent, owner-first discipline to every market
          we work in — giving owners cost clarity from first business case
          through closeout.
        </p>
      </div>
      <div class="grid grid-4 market-cards">
        {markets.map((m) => (
          <div class="card card-accent card-hover">
            <h3>{m.name}</h3>
            <p>{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- CTA ---- -->
  <section class="section section-blue center">
    <div class="container">
      <h2 class="section-title center">Have a project in one of these sectors?</h2>
      <p class="lead mx-auto" style="text-align:center;color:#dbe6f7">
        We'd welcome the chance to talk through how DCW can support your next
        civic, transit, or public project.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary btn-lg">Collaborate Today!</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  @media (max-width: 820px) { .featured { grid-template-columns: 1fr; } }
  .featured-media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(140deg, var(--blue) 0%, var(--blue-900) 60%, var(--teal) 130%);
    box-shadow: var(--shadow-md);
  }
  .featured-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .featured-media .tag { position: absolute; top: 1rem; left: 1rem; z-index: 1; background: #fff; color: var(--blue); }
  .featured-body h2 { margin-bottom: 0.5rem; }
  .client-line { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
  .client-line strong { color: var(--blue); }

  .market-cards h3 { font-size: 1.15rem; }
  .market-cards p { color: var(--muted); font-size: 0.95rem; margin: 0; }
</style>
