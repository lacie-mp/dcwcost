---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";

const projects = [
  {
    name: "Colman Dock",
    sector: "Transportation",
    client: "Washington State Ferries",
    role: "Cost Management",
    summary:
      "Cost management for the state's primary ferry terminal — including the Entry Building and Elevated Pedestrian Connector. DCW developed comparative estimates to reconcile with the contractor and reviewed change orders spanning dry systems, electrical, mechanical and structural work, in-water infrastructure, a temporary pedestrian bridge, and roadway modifications.",
  },
  {
    name: "University Link Light Rail Station",
    sector: "Transportation",
    client: "Sound Transit",
    role: "Cost Estimating & Review",
    summary:
      "A new underground station adjacent to Husky Stadium with a track crossover area — below-grade station, platforms, vertical connections to grade, finishes and building systems. DCW provided milestone estimating, schedule, logistics and temporary-construction review, plus change-order review and substantiation.",
  },
  {
    name: "Mount Vernon Library Commons",
    sector: "Civic",
    client: "City of Mount Vernon · HKP Architects",
    role: "Cost Management",
    summary:
      "A one-of-a-kind, sustainable community library and commons. DCW served as cost management for the project team, collaborating with HKP Architects from design through the start of construction.",
  },
  {
    name: "Operations Admin Center & Vehicle Barn",
    sector: "Public Facilities",
    client: "City of Bellingham",
    role: "Cost Management",
    summary:
      "Cost management for a municipal operations administration center and vehicle barn — a public-works facility supporting the city's fleet and operations teams.",
  },
  {
    name: "Charles D. Cameron Public Services Building",
    sector: "Renovation",
    client: "Public agency",
    role: "Cost Management",
    summary:
      "Cost management for the renovation of an occupied public services building, balancing budget certainty with the constraints of upgrading an existing civic facility.",
  },
  {
    name: "Hemisfair",
    sector: "Civic",
    client: "Public / civic redevelopment",
    role: "Cost Consultancy",
    summary:
      "Cost consultancy supporting a landmark civic park and public-realm redevelopment — part of DCW's portfolio of community-focused public projects.",
  },
];

const sectors = ["All", ...new Set(projects.map((p) => p.sector))];
---

<BaseLayout
  title="Projects"
  description="Selected DCW cost and construction management engagements — Colman Dock, University Link Light Rail Station, Mount Vernon Library Commons, and more across transportation, civic, and public facilities."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Selected work</span>
      <h1>Projects that serve the public good.</h1>
      <p class="lead">
        DCW supports more than 400 projects a year for public agencies,
        municipalities, non-profits, and the architects who design them. A few
        of the landmark efforts we've helped keep accountable are below.
      </p>
      <ul class="chips" aria-label="Project sectors">
        {sectors.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {
          projects.map((p) => (
            <article class="card card--hover project-card">
              <div class="project-top">
                <span class="tag">{p.sector}</span>
                <span class="project-role">{p.role}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="project-client">{p.client}</p>
              <p>{p.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    heading="Your project could be next."
    text="From a single independent estimate to full construction management, we scale to fit the engagement and the Owner's goals."
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface-alt), #fff);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .lead {
    max-width: 64ch;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .chips li {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy-800);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--amber-600);
    background: rgba(245, 166, 35, 0.12);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
  }

  .project-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .project-card h3 {
    margin-bottom: 0.15rem;
  }

  .project-client {
    color: var(--navy-700);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.9rem;
  }
</style>
