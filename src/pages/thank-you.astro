---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank you" description="Thank you for contacting DCW Cost Management.">
  <section class="section center">
    <div class="container narrow-center">
      <span class="eyebrow">Enquiry received</span>
      <h1>Thank you — we'll be in touch.</h1>
      <p class="lead mx-auto" style="text-align:center">
        Thanks for reaching out to DCW Cost Management. A member of our team will
        get back to you shortly. If your enquiry is urgent, please call
        <a href="tel:+12062592990">(206) 259-2990</a>.
      </p>
      <div class="mt-2">
        <a href="/" class="btn btn-primary">Back to home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow-center { max-width: 60ch; }
  .section.center { padding-block: clamp(4rem, 10vw, 7rem); }
</style>
