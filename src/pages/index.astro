---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";

const stats = [
  { value: "2014", label: "Founded in Seattle" },
  { value: "400+", label: "Projects supported each year" },
  { value: "2", label: "Offices — Seattle & Portland" },
  { value: "WBE", label: "Women-owned, employee-owned" },
];

const pillars = [
  {
    title: "Cost Management",
    text: "Independent, market-based cost consultancy that protects the design intent and the Owner's budget from first concept through construction.",
    points: [
      "Third-party cost estimating",
      "Design-based cost management",
      "Business-case cost planning",
      "Cost review, reconciliation & reporting",
    ],
  },
  {
    title: "Construction Management",
    text: "Owner-centered management that keeps design and construction teams aligned, and holds the project to scope, schedule, and budget through delivery.",
    points: [
      "Program & project management",
      "Construction management",
      "Owner's representation",
      "Change-order review & substantiation",
    ],
  },
];

const featured = [
  {
    name: "Colman Dock",
    sector: "Transportation",
    text: "Cost management for Washington State's primary ferry terminal, including the Entry Building and Elevated Pedestrian Connector.",
    href: "/projects",
  },
  {
    name: "University Link Light Rail Station",
    sector: "Transportation",
    text: "Milestone estimating and change-order substantiation for a new underground Sound Transit station beside Husky Stadium.",
    href: "/projects",
  },
  {
    name: "Mount Vernon Library Commons",
    sector: "Civic",
    text: "Cost management alongside HKP Architects on a one-of-a-kind, sustainable community library and commons.",
    href: "/projects",
  },
];

const steps = [
  {
    n: "01",
    title: "Represent the Owner",
    text: "We work only for you — an independent check that keeps costs accurate, responsible, and accountable to the public.",
  },
  {
    n: "02",
    title: "Protect the design intent",
    text: "We stand by the design so pricing reflects what was actually drawn, in enough detail to understand cost and constructability.",
  },
  {
    n: "03",
    title: "Manage through delivery",
    text: "We plan, budget, and schedule, and liaise between design and construction teams so nothing falls through the cracks.",
  },
  {
    n: "04",
    title: "Report with clarity",
    text: "Reconciled estimates and clear reporting give owners, agencies, and boards decision-ready numbers at every milestone.",
  },
];
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Cost &amp; Construction Management · Seattle · Portland</span>
        <h1>Independent cost expertise, on the Owner's side.</h1>
        <p class="lead">
          DCW is an independent, women-owned consultancy providing
          owner-centered construction management and market-based cost
          consultancy — dedicated to preserving the design intent and the
          Owner's requirements on every project.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn--primary">Request a Consultation</a>
          <a href="/projects" class="btn btn--outline">View Our Work</a>
        </div>
      </div>
      <div class="hero-panel" aria-hidden="true">
        <div class="hero-card">
          <span class="hero-card-label">Independent cost check</span>
          <div class="bar"><span style="width: 88%"></span></div>
          <div class="hero-card-rows">
            <div><span>Owner budget</span><strong>On target</strong></div>
            <div><span>Estimate reconciliation</span><strong>Complete</strong></div>
            <div class="ok"><span>Change orders</span><strong>Substantiated</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--4 stats">
        {
          stats.map((s) => (
            <div class="stat">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Two service pillars -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Two disciplines, one accountable partner</h2>
        <p class="lead">
          Owners engage DCW for independent cost consultancy, hands-on
          construction management, or both — a single team that carries the
          numbers from planning through closeout.
        </p>
      </div>
      <div class="grid grid--2">
        {
          pillars.map((p) => (
            <article class="card card--hover pillar">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <ul class="ticks">
                {p.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <p class="pillar-link">
                <a href="/services">Explore {p.title.toLowerCase()} →</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">How we work</span>
        <h2>An owner-centered approach</h2>
      </div>
      <div class="grid grid--4">
        {
          steps.map((step) => (
            <div class="step">
              <span class="step-n">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Selected work</span>
        <h2>Trusted on the region's landmark projects</h2>
        <p class="lead">
          From ferry terminals and light rail to civic libraries, we support
          the public agencies, municipalities, non-profits, and architects
          shaping the Pacific Northwest.
        </p>
      </div>
      <div class="grid grid--3">
        {
          featured.map((p) => (
            <a class="card card--hover feature-card" href={p.href}>
              <span class="tag">{p.sector}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </a>
          ))
        }
      </div>
      <p class="services-more">
        <a href="/projects" class="btn btn--outline">See more projects</a>
      </p>
    </div>
  </section>

  <CallToAction />
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(
        1200px 500px at 85% -10%,
        rgba(245, 166, 35, 0.12),
        transparent 60%
      ),
      linear-gradient(180deg, #fff, var(--surface-alt));
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 940px) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero-copy .lead {
    max-width: 54ch;
    color: var(--body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  /* Hero visual */
  .hero-panel {
    display: flex;
    justify-content: center;
  }

  .hero-card {
    width: 100%;
    max-width: 380px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 1.75rem;
  }

  .hero-card-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bar {
    height: 10px;
    border-radius: 6px;
    background: var(--surface-tint);
    margin: 0.9rem 0 1.4rem;
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--navy-700), var(--amber-500));
  }

  .hero-card-rows {
    display: grid;
    gap: 0.7rem;
  }

  .hero-card-rows div {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-card-rows div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .hero-card-rows span {
    color: var(--muted);
  }

  .hero-card-rows strong {
    color: var(--ink);
  }

  .hero-card-rows .ok strong {
    color: #1f9d55;
  }

  /* Stats */
  .stats {
    text-align: center;
  }

  .stat-value {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--navy-800);
    letter-spacing: -0.02em;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Pillars */
  .pillar {
    display: flex;
    flex-direction: column;
  }

  .ticks {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .ticks li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.95rem;
    color: var(--body);
  }

  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid var(--amber-600);
    border-bottom: 2px solid var(--amber-600);
    transform: rotate(-45deg);
  }

  .pillar-link {
    margin: 1.2rem 0 0;
    font-weight: 600;
  }

  /* Approach steps */
  .step-n {
    display: inline-block;
    font-size: 1rem;
    font-weight: 800;
    color: var(--amber-600);
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .step h3 {
    margin-bottom: 0.35rem;
  }

  .step p {
    color: var(--muted);
    font-size: 0.98rem;
    margin: 0;
  }

  /* Featured projects */
  .feature-card {
    display: block;
    color: inherit;
  }

  .feature-card:hover {
    color: inherit;
  }

  .feature-card h3 {
    margin: 0.8rem 0 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--amber-600);
    background: rgba(245, 166, 35, 0.12);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
  }

  .services-more {
    margin-top: 2rem;
    margin-bottom: 0;
  }
</style>
