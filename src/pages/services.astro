---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";

const costManagement = {
  title: "Cost Management",
  intro:
    "Independent, market-based cost consultancy that gives owners a defensible, continuously reconciled view of cost — protecting both the budget and the design intent from concept to closeout.",
  services: [
    {
      title: "Third-Party Cost Estimating",
      text: "Independent estimates at every design milestone, benchmarked to real market conditions so owners can commit with confidence.",
    },
    {
      title: "Design-Based Cost Management",
      text: "We stand by the design and hold pricing to the design intent, with enough detail to understand cost and constructability.",
    },
    {
      title: "Business-Case Cost Planning",
      text: "Early cost models and options analyses that frame the financial case and test scope against budget before decisions are locked in.",
    },
    {
      title: "Cost Review & Reporting",
      text: "Clear, decision-ready reporting for owners, agencies, and boards — with change-order review and substantiation as the project moves.",
    },
    {
      title: "Reconciliation Management",
      text: "Comparative estimating that reconciles independent numbers with the contractor's pricing to resolve differences and protect value.",
    },
    {
      title: "Feasibility, LCCA & O&M",
      text: "Feasibility studies, master planning and pre-design support, plus life-cycle cost and operations & maintenance analysis.",
    },
  ],
};

const constructionManagement = {
  title: "Construction Management",
  intro:
    "Owner-centered management that keeps design and construction teams aligned and holds the project to scope, schedule, and budget through delivery.",
  services: [
    {
      title: "Program Management",
      text: "Oversight across a program of projects — consistent planning, budgeting, and reporting so a portfolio moves in step.",
    },
    {
      title: "Project Management",
      text: "Hands-on management of planning, budgeting, and scheduling to keep individual projects on track from start to finish.",
    },
    {
      title: "Construction Management",
      text: "Expert guidance through the construction phase, overseeing the work of contractors and subcontractors on the Owner's behalf.",
    },
    {
      title: "Owner's Representation",
      text: "We act as the Owner's advocate, liaising between design and construction teams and other Owner consultants and stakeholders.",
    },
    {
      title: "Change-Order Review",
      text: "Independent review and substantiation of change orders — from mechanical, electrical, and structural to in-water and roadway work.",
    },
    {
      title: "Design & Constructability Coordination",
      text: "Coordination that ensures the contractor prices to the design, with the detail needed to understand cost and buildability.",
    },
  ],
};

const engagements = [
  {
    title: "Cost consultancy",
    text: "Independent, third-party cost estimating and cost management for a single project or a program.",
  },
  {
    title: "Construction management",
    text: "Owner-centered program, project, and construction management through delivery.",
  },
  {
    title: "Combined partnership",
    text: "Both disciplines from one accountable team — cost intelligence and management working together.",
  },
];
---

<BaseLayout
  title="Services"
  description="DCW services span two disciplines: independent Cost Management (third-party estimating, design-based cost management, cost planning, reconciliation) and owner-centered Construction Management (program, project, and construction management, owner's representation)."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Our services</span>
      <h1>Cost Management and Construction Management.</h1>
      <p class="lead">
        DCW delivers two complementary disciplines. Engage either on its own, or
        both together as a single accountable partner — each led by senior
        professionals working only for the Owner.
      </p>
    </div>
  </section>

  <!-- Cost Management -->
  <section class="section" id="cost-management">
    <div class="container">
      <div class="pillar-head">
        <span class="pillar-num">01</span>
        <div>
          <h2>{costManagement.title}</h2>
          <p class="lead">{costManagement.intro}</p>
        </div>
      </div>
      <div class="grid grid--3">
        {
          costManagement.services.map((s) => (
            <article class="card card--hover">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Construction Management -->
  <section class="section section--alt" id="construction-management">
    <div class="container">
      <div class="pillar-head">
        <span class="pillar-num">02</span>
        <div>
          <h2>{constructionManagement.title}</h2>
          <p class="lead">{constructionManagement.intro}</p>
        </div>
      </div>
      <div class="grid grid--3">
        {
          constructionManagement.services.map((s) => (
            <article class="card card--hover">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Engagement models -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Ways to work with us</span>
        <h2>Engage one discipline, or both</h2>
      </div>
      <div class="grid grid--3">
        {
          engagements.map((e) => (
            <div class="card">
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    heading="Not sure which service you need?"
    text="Tell us about your project and we'll recommend the right mix of cost and construction management support."
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface-alt), #fff);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .lead {
    max-width: 64ch;
  }

  .pillar-head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  .pillar-num {
    flex: none;
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
    width: 46px;
    height: 46px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-sm);
  }

  .pillar-head h2 {
    margin-bottom: 0.4rem;
  }

  .pillar-head .lead {
    margin: 0;
  }
</style>
