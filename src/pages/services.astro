---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";

const services = [
  {
    title: "Cost Estimating",
    text: "Order-of-magnitude through elemental and detailed estimates, benchmarked against a live database of comparable projects so every figure is defensible.",
    points: [
      "Feasibility & concept estimates",
      "Elemental cost plans",
      "Detailed quantity take-offs",
      "Bid & tender evaluation",
    ],
    icon: "calculator",
  },
  {
    title: "Cost Planning & Control",
    text: "Continuous budget management through delivery — cash-flow forecasting, valuation review, and change control that keep the project tracking to plan.",
    points: [
      "Budget development & tracking",
      "Cash-flow forecasting",
      "Change-order review",
      "Monthly cost reporting",
    ],
    icon: "chart",
  },
  {
    title: "Value Engineering",
    text: "Facilitated, structured reviews that identify cost savings while protecting the scope, quality, and performance the project depends on.",
    points: [
      "VE workshops & facilitation",
      "Design option cost studies",
      "Lifecycle cost comparison",
      "Savings tracking & reporting",
    ],
    icon: "gears",
  },
  {
    title: "Risk & Contingency",
    text: "Quantitative risk analysis and contingency modeling that convert uncertainty into a managed, transparent line item leadership can defend.",
    points: [
      "Risk register development",
      "Monte Carlo cost modeling",
      "Contingency drawdown planning",
      "Board & lender reporting",
    ],
    icon: "shield",
  },
  {
    title: "Procurement Advisory",
    text: "Independent guidance on delivery models, contract strategy, and market conditions so you enter procurement with leverage and clarity.",
    points: [
      "Delivery model analysis",
      "Contract strategy advice",
      "Market & tender intelligence",
      "Contractor cost validation",
    ],
    icon: "handshake",
  },
  {
    title: "Claims & Final Account",
    text: "Fair, evidence-based resolution of variations, claims, and the final account so projects close cleanly and disputes stay out of court.",
    points: [
      "Variation assessment",
      "Claims evaluation & defense",
      "Final account negotiation",
      "Dispute cost support",
    ],
    icon: "document",
  },
];

const engagements = [
  {
    title: "Project-based",
    text: "Full cost management for a single capital project, from feasibility through final account.",
  },
  {
    title: "Advisory retainer",
    text: "On-call independent cost expertise for your in-house team, boards, or lenders.",
  },
  {
    title: "Portfolio program",
    text: "Standardized estimating, benchmarking, and reporting across a program of projects.",
  },
];

// Inline SVG icon set keyed by the `icon` field above.
const icons: Record<string, string> = {
  calculator:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11"/><line x1="12" y1="11" x2="12" y2="11"/><line x1="16" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="8" y2="15"/><line x1="12" y1="15" x2="12" y2="15"/><line x1="16" y1="15" x2="16" y2="18"/></svg>',
  chart:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="11" width="3" height="6"/><rect x="12" y="7" width="3" height="10"/><rect x="17" y="13" width="3" height="4"/></svg>',
  gears:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>',
  shield:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>',
  handshake:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 17l-2 2a1.5 1.5 0 0 1-2-2l1-1"/><path d="M3 12l4-4 5 5 3-3 6 6"/><path d="M14 8l3-3 4 4"/></svg>',
  document:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>',
};
---

<BaseLayout
  title="Services"
  description="DCW Cost services: cost estimating, cost planning and control, value engineering, risk and contingency, procurement advisory, and claims support."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Our services</span>
      <h1>Independent cost management, end to end.</h1>
      <p class="lead">
        Engage us for a single estimate or partner with us across the whole
        lifecycle. Every service is delivered by senior consultants who own the
        numbers from start to finish.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {
          services.map((s) => (
            <article class="card card--hover service-card">
              <span class="icon-badge" set:html={icons[s.icon]} />
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul class="ticks">
                {s.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Engagement models -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Ways to work with us</span>
        <h2>Engagement models that fit the mandate</h2>
      </div>
      <div class="grid grid--3">
        {
          engagements.map((e) => (
            <div class="card">
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    heading="Not sure which service you need?"
    text="Tell us about your project and we'll recommend the right level of cost support — no obligation."
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface-alt), #fff);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .lead {
    max-width: 62ch;
  }

  .service-card {
    display: flex;
    flex-direction: column;
  }

  .ticks {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .ticks li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.93rem;
    color: var(--body);
  }

  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid var(--amber-600);
    border-bottom: 2px solid var(--amber-600);
    transform: rotate(-45deg);
  }
</style>
