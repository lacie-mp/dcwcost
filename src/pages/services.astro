---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const costServices = [
  {
    title: 'Third-party estimating',
    body: 'Independent estimates that give owners a defensible, unbiased view of cost — separate from the design or construction team.',
  },
  {
    title: 'Design-based cost management',
    body: 'Cost intelligence embedded through every design phase, so budgets and design decisions stay aligned before they become expensive to change.',
  },
  {
    title: 'Business-case cost planning',
    body: 'Early-stage planning that turns a concept into a fundable business case, with the cost basis owners need to make the go/no-go call.',
  },
  {
    title: 'Cost review & reporting',
    body: 'Ongoing review and transparent reporting that keep every stakeholder aligned on where the budget stands at each milestone.',
  },
  {
    title: 'Reconciliation',
    body: 'Structured reconciliation of estimates between parties and phases — resolving differences before they turn into disputes.',
  },
  {
    title: 'Feasibility, LCCA & O&M',
    body: 'Feasibility studies, life-cycle cost analysis, and operations & maintenance cost planning that look past first cost to total cost of ownership.',
  },
];

const cmServices = [
  {
    title: 'Program, project & construction management',
    body: 'End-to-end management across the program, the individual project, and the construction phase — coordinated under one owner-focused team.',
  },
  {
    title: "Owner's representation",
    body: "We represent the owner's interests at the table, translating technical detail into clear decisions and protecting your goals throughout delivery.",
  },
  {
    title: 'Change-order review',
    body: 'Rigorous, independent review of change orders to confirm scope, pricing, and justification before they reach the owner for approval.',
  },
  {
    title: 'Constructability coordination',
    body: 'Early constructability input and coordination that surface conflicts on paper — not in the field — reducing rework, delay, and cost.',
  },
];
---

<Layout title="Services" description="DCW Cost Management services across two pillars: independent cost management and owner-side construction management.">
  <PageHeader
    eyebrow="Services"
    title="Two pillars of owner-side expertise."
    lead="From the earliest business case to final reconciliation, we bring independent cost intelligence and hands-on construction management to every owner we serve."
  />

  <!-- Cost Management -->
  <section class="section" id="cost-management">
    <div class="container">
      <div class="service-intro">
        <span class="tag">Pillar One</span>
        <h2>Cost Management</h2>
        <p class="lead">
          Independent cost expertise that gives owners numbers they can trust —
          and defend — at every phase of a project.
        </p>
      </div>
      <div class="grid grid-3">
        {costServices.map((s) => (
          <div class="card card-accent">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Construction Management -->
  <section class="section section-sand" id="construction-management">
    <div class="container">
      <div class="service-intro">
        <span class="tag">Pillar Two</span>
        <h2>Construction Management</h2>
        <p class="lead">
          Owner-side leadership that keeps schedule, budget, and quality aligned
          with your goals from program planning through closeout.
        </p>
      </div>
      <div class="grid grid-2">
        {cmServices.map((s) => (
          <div class="card card-accent">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-navy">
    <div class="container center">
      <h2>Not sure which service you need?</h2>
      <p class="lead mx-auto" style="text-align:center;color:#c7d2dd">
        Tell us about your project and we'll help you scope the right support —
        cost, construction management, or both.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary">Start a conversation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-intro {
    max-width: 60ch;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .service-intro h2 { margin: 0.75rem 0 0.5rem; }
</style>
