---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";

const values = [
  {
    title: "Owner-centered",
    text: "We work for the Owner and, on public work, the taxpayer — an independent check that keeps costs accurate, responsible, and transparent.",
  },
  {
    title: "Independent & market-based",
    text: "Our cost consultancy is grounded in real market data, not tied to a contractor or product. The advice answers only to your project.",
  },
  {
    title: "Design intent first",
    text: "We stand by the design so pricing reflects what was actually intended, in enough detail to understand cost and constructability.",
  },
  {
    title: "Shared success",
    text: "As a women-owned firm transitioning to employee ownership, our team has a genuine stake in getting every project right.",
  },
];

const team = [
  {
    name: "Trish Drew",
    role: "Founder",
    bio: "Founded DCW in 2014 and continues to guide the firm's mission of independent, owner-centered cost and construction management.",
    initials: "TD",
  },
  {
    name: "Brian Thompson",
    role: "CEO",
    bio: "Leads DCW's strategy and day-to-day operations across the firm's cost and construction management practices.",
    initials: "BT",
  },
  {
    name: "Rachel Quimby",
    role: "Associate Director of Systems & Innovation",
    bio: "Drives the systems, tools, and process innovation that keep DCW's estimating and project delivery consistent and data-informed.",
    initials: "RQ",
  },
  {
    name: "Preeti Pustake",
    role: "Senior Cost Manager",
    bio: "Leads cost management engagements, delivering independent estimates and reconciliation for owners across the portfolio.",
    initials: "PP",
  },
];

const clients = [
  "Public agencies",
  "Municipalities",
  "Architects",
  "Non-profits",
  "Commercial developers",
  "Institutional owners",
];
---

<BaseLayout
  title="About"
  description="DCW Cost & Construction Management is an independent, women-owned and employee-owned cost and construction management consultancy founded in Seattle in 2014."
>
  <!-- Page header -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About DCW</span>
      <h1>An independent partner, built to represent the Owner.</h1>
      <p class="lead">
        DCW Cost &amp; Construction Management is an independent, women-owned
        third-party consultancy delivering owner-centered construction
        management and market-based cost consultancy across the Pacific
        Northwest.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">Our story</span>
        <h2>From one estimator's conviction to a regional firm</h2>
        <p>
          DCW's founder, Trish Drew, spent her career in and around the
          construction industry before turning to cost consulting. When the
          firm she worked for was acquired and shifted toward only the largest
          projects, she saw owners of every size being underserved — and in
          2014 she started DCW to change that.
        </p>
        <p>
          A decade on, DCW supports more than 400 projects a year from offices
          in Seattle and Portland. As independent cost consultants, the team
          represents the Owner and the taxpayer, providing the checks and
          balances that keep budgets accurate and responsible — and standing by
          the design so the Owner gets what was intended.
        </p>
        <p>
          In 2025 DCW transitioned to an Employee Ownership Trust, one of the
          first in Washington State. The move secured the firm's continuity and
          its status as a women-owned business, with women making up more than
          half of DCW's management and operations. Founder Trish Drew continues
          to guide the firm's mission alongside CEO Brian Thompson and the
          leadership team.
        </p>
      </div>
      <aside class="about-facts">
        <h3>At a glance</h3>
        <ul>
          <li><span>Founded</span><strong>2014</strong></li>
          <li><span>Headquarters</span><strong>Seattle, WA</strong></li>
          <li><span>Second office</span><strong>Portland, OR</strong></li>
          <li><span>Projects / year</span><strong>400+</strong></li>
          <li><span>Ownership</span><strong>Women-owned · EOT</strong></li>
          <li><span>Certifications</span><strong>WBE · WOSB</strong></li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we stand for</span>
        <h2>Values that keep us on your side</h2>
      </div>
      <div class="grid grid--2">
        {
          values.map((v) => (
            <article class="card card--hover">
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we serve</span>
        <h2>A diverse clientele across the public and private sectors</h2>
      </div>
      <ul class="client-grid">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Team -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Leadership</span>
        <h2>The people behind your numbers</h2>
      </div>
      <div class="grid grid--4">
        {
          team.map((member) => (
            <article class="card team-card">
              <div class="avatar" aria-hidden="true">
                {member.initials}
              </div>
              <h3>{member.name}</h3>
              <p class="role">{member.role}</p>
              <p>{member.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    heading="Let's talk about your project."
    text="Reach our Seattle or Portland team to see how independent cost and construction management can protect your budget and your design intent."
  />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface-alt), #fff);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .lead {
    max-width: 62ch;
  }

  .about-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .about-facts {
    background: var(--navy-900);
    color: #cdd9e6;
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }

  .about-facts h3 {
    color: #fff;
    margin-bottom: 1rem;
  }

  .about-facts ul {
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .about-facts li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .about-facts li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .about-facts span {
    color: #93a6bd;
  }

  .about-facts strong {
    color: #fff;
  }

  /* Clients */
  .client-grid {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 720px) {
    .client-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .client-grid li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--navy-800);
    box-shadow: var(--shadow-sm);
  }

  .team-card {
    text-align: center;
  }

  .avatar {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  }

  .team-card .role {
    color: var(--amber-600);
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
  }

  .team-card p:last-child {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
