---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'DCW Cost Management',
  description = 'Independent, owner-centered cost and construction management firm serving the Pacific Northwest. Women-owned (WBE/WOSB), founded 2014.',
} = Astro.props;

const fullTitle =
  title === 'DCW Cost Management'
    ? title
    : `${title} — DCW Cost Management`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--green);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip-link:focus { left: 0; }
    </style>
  </body>
</html>
