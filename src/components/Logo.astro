---
/*
  DCW brand mark — real logo files.
  tone="color" -> full-color logo (blue DCW + green/blue swoosh); use on light backgrounds
  tone="light" -> white logo; use on dark / photo / blue backgrounds
  `size` is the rendered height in px (width scales automatically).
*/
const { tone = 'color', size = 46, class: className = '' } = Astro.props;
const src = tone === 'light' ? '/Picture1.png' : '/DCW-Square-Logo-1.png';
---

<img
  src={src}
  alt="DCW Cost Management"
  height={size}
  class={`dcw-logo ${className}`}
  style={`height:${size}px`}
  decoding="async"
/>

<style>
  .dcw-logo { display: block; width: auto; }
</style>
