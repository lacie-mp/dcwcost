---
/*
  Brand line-art icons for DCW's market sectors.
  Uses currentColor, so set the color via CSS where it's used
  (white on the gradient tiles, brand blue on light cards).
*/
const { name, class: cls = '' } = Astro.props;

const icons = {
  // Classical civic building / capitol
  'Government': `
    <path d="M2 9.5 12 4l10 5.5"/>
    <path d="M3 21h18M3 18h18M4 11.5h16"/>
    <path d="M5.5 12v6M9.5 12v6M14.5 12v6M18.5 12v6"/>`,
  // Heart with a heartbeat / pulse line
  'Healthcare': `
    <path d="M12 21S4 15.5 4 9.6A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 8 2.6C20 15.5 12 21 12 21Z"/>
    <path d="M5.5 12H9l1.5-3 2.5 6 1.5-3H18"/>`,
  // Graduation cap / mortarboard
  'Higher Education': `
    <path d="M2 8.5 12 4.5l10 4-10 4z"/>
    <path d="M22 8.5V13"/>
    <path d="M6 10.4V15c3 1.9 9 1.9 12 0v-4.6"/>`,
  // Open book
  'K-12': `
    <path d="M12 6.5C10 5 5.5 5 3.5 6v12.5c2-1 6.5-1 8.5.5 2-1.5 6.5-1.5 8.5-.5V6c-2-1-6.5-1-8.5.5Z"/>
    <path d="M12 6.5V19"/>`,
  // Evergreen tree (PNW parks)
  'Parks': `
    <path d="M12 3.5 8.6 8.5h1.8L7.2 13H10l-4 4.5h12L14 13h2.8l-3.2-4.5h1.8z"/>
    <path d="M12 17.5v3M6 20.5h12"/>`,
  // Anchor (marine / ports)
  'Ports': `
    <circle cx="12" cy="5" r="2"/>
    <path d="M12 7v13M8 10h8"/>
    <path d="M4.5 14c0 4.5 3.5 6.5 7.5 6.5s7.5-2 7.5-6.5"/>
    <path d="M4.5 14 3 15.6M4.5 14 6 15.6M19.5 14 18 15.6M19.5 14 21 15.6"/>`,
  // Cable-stayed bridge
  'Transportation & Utilities': `
    <path d="M3 16h18"/>
    <path d="M7 16V5M17 16V5"/>
    <path d="M7 5 3.5 14M7 5l3.5 9M17 5l-3.5 9M17 5l3.5 9"/>
    <path d="M4 20h4M10 20h4M16 20h4"/>`,
  // Paw print (animal welfare)
  'Zoos & Animal Welfare': `
    <circle cx="6.5" cy="10" r="1.8"/>
    <circle cx="10.2" cy="6.8" r="1.8"/>
    <circle cx="13.8" cy="6.8" r="1.8"/>
    <circle cx="17.5" cy="10" r="1.8"/>
    <path d="M12 12c-3.5 0-5.5 2.6-5.5 5 0 2 1.5 3 3.5 2.2 1.2-.5 2.8-.5 4 0 2 .8 3.5-.2 3.5-2.2 0-2.4-2-5-5.5-5Z"/>`,
};

const inner = icons[name] || '';
---
<svg
  class={`market-ico ${cls}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
