---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Company",
    links: [
      { href: "/about", label: "About Us" },
      { href: "/projects", label: "Projects" },
      { href: "/services", label: "Services" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    title: "Services",
    links: [
      { href: "/services", label: "Cost Estimating" },
      { href: "/services", label: "Cost Planning & Control" },
      { href: "/services", label: "Value Engineering" },
      { href: "/services", label: "Risk & Contingency" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label="DCW Cost — home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="30" height="30">
            <rect width="32" height="32" rx="6" fill="#f5a623"></rect>
            <path d="M8 22V13l8-5 8 5v9h-5v-6h-6v6H8z" fill="#142842"></path>
            <rect x="7" y="22" width="18" height="2.5" rx="1" fill="#142842"
            ></rect>
          </svg>
        </span>
        <strong>DCW Cost</strong>
      </a>
      <p>
        Independent construction cost-management consultants helping owners,
        developers, and contractors build with confidence and control.
      </p>
      <address>
        1200 Commerce Street, Suite 450<br />
        Dallas, TX 75202<br />
        <a href="tel:+12145550142">(214) 555-0142</a> ·
        <a href="mailto:hello@dcwcost.com">hello@dcwcost.com</a>
      </address>
    </div>

    {
      columns.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} DCW Cost Management, LLC. All rights reserved.</p>
    <p class="footer-legal">
      <a href="/contact">Privacy</a> · <a href="/contact">Terms</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: #a9bace;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-brand .brand {
    color: #fff;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .footer-brand .brand strong {
    font-size: 1.2rem;
  }

  .footer-brand p {
    max-width: 40ch;
    color: #93a6bd;
  }

  address {
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.7;
    color: #93a6bd;
  }

  address a {
    color: #cdd9e6;
  }

  address a:hover {
    color: var(--amber-500);
  }

  .footer-col h4 {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .footer-col a {
    color: #a9bace;
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: var(--amber-500);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    color: #7e93ac;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal a {
    color: #7e93ac;
  }

  .footer-legal a:hover {
    color: var(--amber-500);
  }
</style>
